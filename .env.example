# Copy to .env for docker compose (optional; defaults work).
BACKEND_PORT=8004
FRONTEND_PORT=3004
VITE_API_BASE=http://localhost:8004
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
HF_TOKEN=
# Docker: faster-whisper. M4 Mac host (best speed/quality): STT_BACKEND=mlx
STT_BACKEND=faster-whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true
# mlx example: WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
CORS_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
# Set to 1 to install faster-whisper/torch/pyannote in the backend image (heavy).
INSTALL_STT=0
